        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.3.0",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
