# Module toggles. `core` (default for fresh installs): events, registration,
# seating, teams, games, tournaments, identity, notifications, preflight.
# Existing installs that want everything: MODULES_PROFILE=full.
# Override single modules with MODULE_<KEY>=true|false, e.g. MODULE_JUKEBOX=true.
MODULES_PROFILE=core

# Production: set APP_ENV=production and APP_DEBUG=false (never expose stack
# traces/debug info publicly), and APP_URL to the real externally-reachable
# origin (used to generate absolute URLs — Discord OAuth redirect, email
# links, etc). See README's "Production deployment" section.
APP_NAME=LANoMAT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Storage stays UTC (config/app.php); people read and type dates in this zone.
APP_DISPLAY_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# host port 5434: default 5432 is taken by another local container (see compose.yml)
# Production (compose --profile prod): the app reaches Postgres over the compose
# network, so DB_HOST=postgres and DB_PORT=5432 there (the 127.0.0.1:5434 values
# below are for host-side dev only). DB_PASSWORD must match POSTGRES_PASSWORD
# (read by compose's postgres service, default `lanomat`); set both to a strong
# value before the first start. POSTGRES_DB names the database compose creates.
# See docs/deploy-lan-raute1.md.
# POSTGRES_PASSWORD=lanomat
# POSTGRES_DB=lanomat
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=lanomat
DB_USERNAME=lanomat
DB_PASSWORD=lanomat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Max size (KB) for Livewire/Filament file uploads — voice-client installers
# and M7 file-sharing exceed Livewire's 12 MB default. Must stay <= the PHP
# upload_max_filesize/post_max_size (docker/frankenphp/php.ini in prod).
LIVEWIRE_MAX_UPLOAD_KB=1048576

CACHE_STORE=redis
# Rate limiters (login, check-in) use their own store so a Redis outage cannot break login.
CACHE_LIMITER_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# host port 6380: default 6379 is taken by another local container (see compose.yml)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional login gate: only members of this server may log in (empty = anyone).
# See docs/deploy-lan-raute1.md, section "Discord login gate".
DISCORD_LOGIN_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Leave empty: every event gets a category of its own for its match channels and a second
# one, "Archiv: <event>", for the text channels of finished matches (numbered follow-ups
# once a category holds 50 channels). Set an id only to force all match channels into one
# fixed category; the archive stays per event either way.
DISCORD_MATCH_CATEGORY_ID=
DISCORD_MATCH_CHANNEL_CLEANUP_DELAY_MINUTES=30
DISCORD_PUBLIC_KEY=
# Also the bot's own user id: per-match channels grant the bot access before @everyone is denied, so it must be set.
DISCORD_APPLICATION_ID=
DISCORD_GATEWAY_BRIDGE_SECRET=
DISCORD_GATEWAY_INGRESS_URL=http://app/internal/discord/gateway
DISCORD_PRESENCE_STATUS=online
DISCORD_PRESENCE_ACTIVITY_TYPE=Watching
DISCORD_PRESENCE_ACTIVITY_NAME=LANoMAT
# The sidecar answers 200 on /healthz only while it is connected to Discord, 503 otherwise:
# DISCORD_GATEWAY_HEALTH_URL=http://discord-gateway:3000/healthz
DISCORD_GATEWAY_HEALTH_URL=

# Steam (M9, Identity+): OpenID, identity-only — STEAM_API_KEY is a Steam
# Web API key (used to fetch the profile after login), not an OAuth client
# secret. STEAM_ALLOWED_HOSTS is a comma-separated allowlist of return-to
# hosts (leave empty in dev to allow any).
# Production: STEAM_REDIRECT_URI=https://lan.raute1.org/settings/connections/steam/callback
# and STEAM_ALLOWED_HOSTS=lan.raute1.org. The API key is issued at
# steamcommunity.com/dev/apikey with the domain set to the public host.
STEAM_API_KEY=
STEAM_REDIRECT_URI=http://localhost:8000/settings/connections/steam/callback
STEAM_ALLOWED_HOSTS=

# Twitch (M9, Identity+): standard OAuth2 with a token refresh lifecycle —
# TWITCH_CLIENT_ID/TWITCH_CLIENT_SECRET are the app's Client ID/Secret from
# the Twitch Developer Console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/settings/connections/twitch/callback

# Reverb (websockets). REVERB_SERVER_HOST/PORT is where `reverb:start` binds
# inside the container (0.0.0.0:8080, see compose.yml's `reverb` service).
# REVERB_HOST/PORT/SCHEME is where the browser/Echo client connects — the
# non-default host port 8081 (compose maps 8081:8080; 8080 is commonly taken
# by other local dev servers, matching the postgres/redis non-default-port
# convention above).
#
# Production: set REVERB_SCHEME=https (and REVERB_PORT=443, REVERB_HOST to
# the real domain) once a TLS-terminating reverse proxy sits in front of
# Reverb (deferred to M7's Traefik setup — see README). REVERB_ALLOWED_ORIGINS
# locks the websocket handshake down to the real origin(s) the browser client
# connects from — a comma-separated list, e.g.
# "https://lan.example,https://admin.lan.example". Left unset (or `*`), any
# origin is allowed, which is fine for local dev but must be set for prod
# (see config/reverb.php). Production: REVERB_ALLOWED_ORIGINS=https://lan.raute1.org
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*

# Content Security Policy: report-only (default, never blocks) | enforce | off.
# Violations are logged to storage/logs/csp.log. See docs/deploy-lan-raute1.md.
CSP_MODE=report-only

VITE_APP_NAME="${APP_NAME}"
# NOTE: the browser's Reverb connection is delivered at runtime as an Inertia
# shared prop (from the server's REVERB_* config above), NOT via VITE_REVERB_*.
# Vite inlines VITE_* at build time, so baking them into the image would ignore
# the deploy .env — the `reverb` shared prop (HandleInertiaRequests) is used
# instead. Set REVERB_HOST/PORT/SCHEME above; there is nothing VITE_ to set here.

# Mumble voice (M3, Modul 12). MUMBLE_ICE_SECRET gates the Ice interface
# (both read and write — see compose.yml's `mumble` service, which sets it
# as both `icesecretwrite` and the SuperUser password) and doubles as the
# mumble-admin sidecar's bearer token. MUMBLE_SERVER_PASSWORD is the
# LAN-internal join password for the Mumble virtual server itself (event
# participants only, not related to the Ice secret).
# Host ports: 64738 (TCP+UDP) is Mumble's own default — no local collision
# observed, kept as-is. The mumble-admin Ice-REST sidecar uses the
# non-default host port 8085 (default 8000 is commonly taken by other local
# dev servers, matching the postgres/redis/reverb convention above); the
# Laravel app talks to it over the compose network at
# http://mumble-admin:8000, not via the host port.
MUMBLE_ICE_SECRET=
MUMBLE_SERVER_PASSWORD=
# Trusted TLS for Mumble instead of its self-signed certificate (docs/infra/local-service-tls.md):
# start the `venue-certs` profile (certs-export) and point these at the exported wildcard files.
# Empty = Mumble's self-signed default.
# MUMBLE_SSL_CERT=/certs/wildcard.<LAN_DOMAIN>/certificate.crt
# MUMBLE_SSL_KEY=/certs/wildcard.<LAN_DOMAIN>/privatekey.key
# CERTS_GID=10000   # the group Mumble's image runs as (10000 in 1.5.x, 1000 in 1.4.x)
MUMBLE_HOST=localhost
MUMBLE_PORT=64738
MUMBLE_ADMIN_REST_URL=http://mumble-admin:8000

# Web voice chat (WebVoice module, MODULE_WEB_VOICE=true): self-hosted LiveKit SFU, see
# docs/infra/livekit-web-voice.md. Leave empty to keep the module's voice part off (the text chat
# still works). LIVEKIT_URL is the browser-facing wss:// signaling URL on a TRUSTED certificate
# (the microphone needs a secure context); LIVEKIT_API_URL is the internal address the app uses for
# server calls; key and secret must match the rendered docker/livekit/livekit.yaml
# (scripts/ops/render-livekit-config.sh); the secret needs at least 32 characters.
# LIVEKIT_NODE_IP and LIVEKIT_DOMAIN are read by the render script / compose (the `web-voice` profile).
MODULE_WEB_VOICE=
LIVEKIT_URL=
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=
LIVEKIT_DOMAIN=

# TeamSpeak voice (M8, Voice-Multiprovider). TEAMSPEAK_QUERY_PASSWORD is the
# ServerQuery query-account password (see docker/teamspeak-admin/README.md
# for how to create/scope it) — separate from TEAMSPEAK_ADMIN_TOKEN, the
# bearer token the teamspeak-admin sidecar's own REST API requires (mirrors
# MUMBLE_ICE_SECRET/MUMBLE_ADMIN_TOKEN's split above).
# Host ports: 9989 (voice, UDP) and 30033 (file transfer, TCP) are
# TeamSpeak's own defaults, no local collision observed. The
# teamspeak-admin ServerQuery-REST sidecar uses the non-default host port
# 8086 (matching mumble-admin's 8085 convention above); the Laravel app
# talks to it over the compose network at http://teamspeak-admin:8000, not
# via this port. Mode A (M8): unverified until real hardware, see
# docs/teamspeak-setup.md.
TEAMSPEAK_QUERY_PASSWORD=
TEAMSPEAK_ADMIN_TOKEN=
TEAMSPEAK_HOST=localhost
TEAMSPEAK_PORT=9987
TEAMSPEAK_ADMIN_REST_URL=http://teamspeak-admin:8000

# Pelican Panel (M6, game servers) — see docs/gameservers-pelican.md.
# Two token types: PELICAN_APPLICATION_TOKEN is an Application API key
# (`papp_...`, panel admin > API keys) for create/show/list/delete servers,
# nodes, allocations and eggs; PELICAN_CLIENT_TOKEN is a Client API key
# (`pacc_...`, account API keys) for power signals and runtime state. The
# client key must belong to a NON-admin service user (a root admin's client
# key would also work on application endpoints), and that user's panel id is
# PELICAN_OWNER_USER_ID: it owns every server LANoMAT creates. (The old
# `ptla_`/`ptlc_` prefixes are Pterodactyl's and no longer apply.)
# PELICAN_PANEL_URL is the panel base URL; PELICAN_URL is accepted as an alias.
# PELICAN_DEFAULT_NODE_ID is the node new servers go on (legacy name:
# PELICAN_NODE_ID, still honoured).
PELICAN_PANEL_URL=
PELICAN_APPLICATION_TOKEN=
PELICAN_CLIENT_TOKEN=
PELICAN_OWNER_USER_ID=
PELICAN_DEFAULT_NODE_ID=
# Optional: PELICAN_TIMEOUT / PELICAN_CONNECT_TIMEOUT (seconds, default 10/5),
# PELICAN_DEFAULT_DISK_MB (5120) / PELICAN_DEFAULT_CPU_PERCENT (0 = unlimited)
# for presets that set no limits of their own.
# PELICAN_MAX_RUNNING_SERVERS: optional node-wide cap on total running
# servers (all requesters combined). Bounds the automatic match-provisioning
# path, which has no requester to attribute a per-user cap to. Unset (empty)
# means unlimited.
PELICAN_MAX_RUNNING_SERVERS=
# Port pool for game servers (default 27015-27050); optional creation of missing
# pool allocations (needs an application key with write scope on allocations).
# PELICAN_PORT_POOL=27015-27050
# PELICAN_CREATE_ALLOCATIONS=false
# PELICAN_ALLOCATION_IP=
# Secrets for presets that require them (never stored in a preset):
# PELICAN_STEAM_WEB_API_KEY=
# PELICAN_GSLT=

# LanCache (M7, roadmap 7.5). Parametrizes the `docker run` bootstrap
# ApplyLancacheSetup runs over SSH on a role=lancache RemoteHost (see
# docs/lancache-setup.md) — LanCache itself runs on a SEPARATE host, never
# in this repo's own compose.yml. Leave unset to use the defaults
# (lancachenet/monolithic:latest, 8.8.8.8, lancache_data) baked into
# config/services.php.
LANCACHE_IMAGE=
LANCACHE_UPSTREAM_DNS=
LANCACHE_CACHE_VOLUME=

# Provisioning (optional module `provisioning`, docs/provisioning.md). The
# Proxmox API token is NOT configured here: register it with
# `php artisan provisioning:register-hypervisor` (stored encrypted). `fake` binds an
# in-memory hypervisor for local development.
PROVISIONING_DRIVER=proxmox

# Own Docker registry (M7, roadmap 7.2). REGISTRY_HOST is the registry's
# host[:port] (an external registry, or the optional registry:2 Compose
# service documented in docs/registry-setup.md) — used both as the
# app-image tag prefix for a prod pull and, as a repo-level Actions
# *variable* (not this .env value), by .github/workflows/publish-images.yml
# to decide whether to run at all. REGISTRY_USERNAME/REGISTRY_PASSWORD are
# read locally for `docker login` (see docs/registry-setup.md); in CI they
# are configured as Actions *secrets* of the same name, not from this file.
REGISTRY_HOST=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Traefik v3 ingress (M7, roadmap 7.1). APP_DOMAIN is the public hostname
# routed to the `app` service (participant UI + Filament `/admin`, same
# service/router — see compose.yml's `app` labels); `ws.${APP_DOMAIN}` is
# derived automatically for `reverb-prod`'s router, no separate variable
# needed. ACME_EMAIL is the Let's Encrypt account email (required by the
# `letsencrypt` certresolver in docker/traefik/traefik.yml). On a pure-LAN
# deployment with no public DNS, leave both unset: the `app`/`reverb-prod`
# Host() rules then never match a real request, and Traefik's `websecure`
# entrypoint serves its self-signed default certificate to any client that
# connects by IP instead — see docs/traefik-setup.md for the full
# ACME-vs-self-signed decision and setup steps.
# Production example: APP_DOMAIN=lan.raute1.org (Traefik also serves
# ws.${APP_DOMAIN} for Reverb, so DNS needs A records for both names) and
# ACME_EMAIL=<operator mailbox for Let's Encrypt expiry notices>. Ports 80/443
# must be reachable for the ACME HTTP-01 challenge. Both are read by compose
# (Traefik labels / certresolver), not by the Laravel app.
APP_DOMAIN=
ACME_EMAIL=
# App at the venue behind the cloud server (docs/infra/app-at-the-venue.md).
# On the venue server: use the venue static Traefik file (DNS-01 certificates, and
# the cloud Traefik's tunnel address as the only trusted PROXY protocol source):
# cp docker/traefik/traefik.venue.example.yml docker/traefik/traefik.venue.yml
# TRAEFIK_STATIC_FILE=./docker/traefik/traefik.venue.yml
# On the cloud server (profile venue-entry): where TLS is passed through to.
# VENUE_UPSTREAM=<venue tunnel address>:443

# Music Assistant (M11, Jukebox). MUSIC_ASSISTANT_URL is the MA server's
# HTTP/JSON-RPC base (default port 8095). MUSIC_ASSISTANT_TOKEN is a
# long-lived bearer token for that API. MUSIC_ASSISTANT_PLAYER_ID is the MA
# player/queue id LANoMAT's single configured jukebox player controls.
MUSIC_ASSISTANT_URL=http://music-assistant:8095
MUSIC_ASSISTANT_TOKEN=
MUSIC_ASSISTANT_PLAYER_ID=

# Gallery (M12). IMAGE_DRIVER controls intervention/image-laravel's
# ImageManager (config/intervention-image.php) — left unset so it defaults
# to the GD driver (\Intervention\Image\Drivers\Gd\Driver::class), which is
# what strips EXIF (including GPS) on re-encode; do not switch to Imagick
# here without re-checking that EXIF-stripping behavior. GALLERY_* tune the
# upload/thumbnail pipeline (app/Modules/Gallery/Actions/UploadPhoto.php).
# The `gd` PHP extension is required for this pipeline — it is already
# installed in docker/Dockerfile (both build stages); a locally built app
# image predating M12 needs a rebuild (`docker compose build app` or
# equivalent) to pick it up. LIVEWIRE_MAX_UPLOAD_KB above already covers the
# gallery upload's request-size ceiling (1 GB default) — GALLERY_MAX_UPLOAD_MB
# is the tighter, gallery-specific cap actually enforced by UploadPhoto.
IMAGE_DRIVER=
GALLERY_MAX_UPLOAD_MB=25
GALLERY_MAX_EDGE=2560
GALLERY_THUMB_WIDTH=400
GALLERY_JPEG_QUALITY=82

# Preflight backup freshness: marker written by scripts/ops/backup.sh (mounted
# read-only into the prod app container, see compose.yml).
# BACKUP_MARKER_PATH=/var/backups/lanomat/.last-success

# Shared files (Files module). Every type is allowed except HTML/SVG/JS;
# uploads stay pending until orga approves. FILES_STORE=local (default) keeps
# files on the app's private disk and streams downloads. FILES_STORE=host
# forwards uploads over SFTP to the registered RemoteHost FILES_HOST_ID and
# redirects downloads to a signed link on FILES_HOST_URL (nginx on the
# LanCache host). FILES_HOST_SECRET: >= 32 chars of [A-Za-z0-9_-], same value
# as the nginx file host (openssl rand -hex 32). See docs/infra/file-host.md.
# FILES_MAX_UPLOAD_MB=200          # legacy form upload only (FILES_STORE=local, or host without FILES_TUS_URL)
# FILES_PER_USER_QUOTA_MB=102400   # per person per event, 100 GB
# FILES_MAX_FILE_GB=50             # per file on the resumable path; keep equal to tusd -max-size
# FILES_STORE=local
# FILES_HOST_ID=
# FILES_HOST_PATH=/data
# FILES_HOST_URL=https://files.<LAN_DOMAIN>:8443
# FILES_HOST_SECRET=
# FILES_URL_TTL_SECONDS=300
# Resumable big-file uploads (tus): with FILES_STORE=host AND FILES_TUS_URL set, every upload goes
# browser -> tusd on the file host; the app only issues tickets and answers tusd's hooks.
# FILES_TUS_URL=https://files.<LAN_DOMAIN>:8443/upload/
# FILES_TUS_HOOK_SECRET=            # >= 32 chars of [A-Za-z0-9_-], same value as the file host's .env (openssl rand -hex 32)
# FILES_TUS_TICKET_TTL_SECONDS=600  # single-use upload ticket
# FILES_TUS_UPLOAD_TTL_HOURS=24     # a started upload that stays unfinished this long is swept
# FILES_TUS_DATA_DIR=/data          # where tusd writes, as tusd sees it (the container mount)
# FILES_TUS_CHUNK_MB=64
# FILES_TUS_TICKETS_PER_MINUTE=20
