# Production Caddyfile for LANoMAT v2's FrankenPHP app image.
#
# This mirrors FrankenPHP's own documented Laravel serving snippet
# (https://frankenphp.dev/docs/laravel/): serve `public/`, let `php_server`
# route everything through Laravel's front controller, and compress
# responses. No `worker` directive is configured — see docker/Dockerfile's
# header comment for why LANoMAT v2 runs FrankenPHP's classic per-request
# mode rather than Octane/worker mode for now.
{
	skip_install_trust
	frankenphp
}

{$SERVER_NAME:localhost} {
	root * public/

	# Compression must never sit on the assistant's event-stream endpoints: `text/*` is in
	# Caddy's default encode matcher, and an encoder can hold a stream back until it ends.
	# (Newer Caddy releases flush `text/event-stream` anyway; the explicit exclusion keeps it
	# independent of the build, see docs/infra/assistant.md.)
	@compressible {
		not path /orga/assistant/chat /orga/assistant/*/decisions
	}
	encode @compressible zstd br gzip

	php_server {
		try_files {path} index.php
	}
}
