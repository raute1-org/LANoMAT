# LANoMAT file host: serves shared files to LAN clients. Rendered by the
# official nginx image's envsubst step (only variables matching
# NGINX_ENVSUBST_FILTER=^FILES_ are substituted; nginx's own $variables are
# left alone). Runbook: docs/infra/file-host.md
#
# This file is included inside the http {} block of the stock nginx.conf.

# Access log WITHOUT the query string: $uri has no arguments, so the signature
# (md5=...) and the download name never reach the log. Never use $request or
# $request_uri in a log format here.
log_format files_nosig '$remote_addr [$time_local] "$request_method $uri" '
                       '$status $body_bytes_sent rt=$request_time "$http_user_agent"';

# Concurrent connections per client address. Generous on purpose (browsers open
# up to 6, download managers 16+); this stops a runaway client, it does not
# throttle LAN speed. There is deliberately NO limit_rate anywhere.
limit_conn_zone $binary_remote_addr zone=files_per_client:10m;

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:files_tls:10m;
    ssl_session_tickets off;

    access_log /var/log/nginx/files.access.log files_nosig;
    # The error log CAN contain the full request line (including md5/expires)
    # when a file is missing. The link is dead after its TTL; keep this log
    # local and root-readable.
    error_log  /var/log/nginx/files.error.log warn;

    server_tokens off;

    # Big-file delivery. sendfile keeps the bytes in the kernel (page cache to
    # socket); tcp_nopush fills packets before sending, which is what you want
    # for bulk transfers. LAN parties download the SAME few files from many
    # clients, so the page cache is an asset: do not enable directio by default.
    sendfile           on;
    sendfile_max_chunk 1m;     # one fast client cannot monopolise a worker
    tcp_nopush         on;
    tcp_nodelay        on;
    aio                threads;
    # directio 64m;            # only if the file set far exceeds RAM and cold
    #                          # reads stall other connections: files at least
    #                          # this large then bypass the page cache and are
    #                          # read through the thread pool (aio threads).
    output_buffers     2 1m;

    # Anything that is not a signed download link or the upload path is refused.
    location / {
        return 404;
    }

    # --- resumable uploads (tus) --------------------------------------------
    # The browser talks tus to this path; nginx forwards to tusd in the compose
    # network. The bytes never touch the app server. CORS is answered by tusd
    # (-cors-allow-origin), so no add_header here (it would duplicate headers).
    location /upload/ {
        # Free-space guard: while the guard script has flagged the disk as
        # nearly full, no NEW upload may start (POST); running ones continue.
        set $upload_guard "";
        if ($request_method = POST) { set $upload_guard "P"; }
        if (-f /guard/disk-full)    { set $upload_guard "${upload_guard}F"; }
        if ($upload_guard = "PF")   { return 507; }

        proxy_pass http://tusd:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $http_host;

        # Streaming, not buffering: a 64 MiB chunk (or a whole file from a
        # client without chunking) must flow straight to tusd. Without these
        # nginx would spool every request body to /tmp (read-only here) and
        # tusd would only see the bytes at the end.
        client_max_body_size   0;
        proxy_request_buffering off;
        proxy_buffering        off;

        # Timeouts that fit multi-hour transfers: these apply BETWEEN reads and
        # writes, not to a whole upload. A stalled client is dropped after 5
        # minutes and resumes with a new request; tusd keeps what it received.
        client_body_timeout 300s;
        proxy_send_timeout  3600s;
        proxy_read_timeout  3600s;
        send_timeout        300s;

        # Nothing about an upload is cacheable.
        add_header Cache-Control "no-store" always;
    }

    location /dl/ {
        alias /data/;
        autoindex off;

        limit_except GET HEAD { deny all; }
        limit_conn files_per_client 32;
        limit_conn_status 429;

        # --- signature check -------------------------------------------------
        # Link: /dl/<path>?expires=<unix>&md5=<base64url>&n=<percent-encoded name>
        # The hash covers expiry + decoded path + download name + the secret:
        #   base64url(md5("<expires><uri>|<n> <secret>"))
        # A link without an expiry would never expire, so refuse it explicitly.
        if ($arg_expires = "") { return 403; }
        if ($arg_n = "")       { return 403; }

        secure_link     $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri|$arg_n ${FILES_HOST_SECRET}";

        if ($secure_link = "")  { return 403; }   # missing or wrong signature
        if ($secure_link = "0") { return 410; }   # valid signature, expired

        # --- the response is always an opaque attachment ---------------------
        # Every type is served as an octet stream and may never be rendered or
        # sniffed by a browser. $arg_n is signed and was percent-encoded by the
        # app (rawurlencode), so it cannot carry quotes, CR or LF.
        types { }
        default_type application/octet-stream;
        add_header Content-Disposition "attachment; filename=\"download\"; filename*=UTF-8''$arg_n" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Cache-Control "private, no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        # Range requests (resume, download managers) are handled by nginx for
        # static files: Accept-Ranges, 206 and If-Range work out of the box.
    }
}

# --- tusd hook relay (compose network only) ----------------------------------
# tusd can forward client headers to its hook endpoint but cannot add a static
# secret. This listener is NOT published: only tusd (same compose network) can
# reach it. It relays the hook call to the app and adds the shared secret as a
# header, so the secret is never in a URL and never leaves this machine except
# inside the TLS connection to the app. Clients on :8443 cannot reach /hook.
server {
    listen 8081;
    server_name _;

    access_log off;   # hook bodies and the secret never reach a log
    error_log  /var/log/nginx/files.error.log warn;
    server_tokens off;

    # Resolve the app host at request time, not at start: a venue DNS hiccup
    # must not keep the file host from starting. 127.0.0.11 is Docker's resolver.
    resolver 127.0.0.11 valid=30s ipv6=off;

    location = /hook {
        limit_except POST { deny all; }

        set $app_hook "${FILES_APP_HOOK_URL}";
        proxy_pass $app_hook;

        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        # Overwrites anything a client could have put there.
        proxy_set_header X-Tusd-Hook-Secret "${FILES_TUS_HOOK_SECRET}";
        proxy_set_header Content-Type "application/json";
        proxy_set_header Accept "application/json";

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    location / {
        return 404;
    }
}
