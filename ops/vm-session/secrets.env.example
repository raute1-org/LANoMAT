# Secrets for the unattended LANoMAT VM session.
# Copy to ~/secrets/lanomat.env on the VM, chmod 600, fill in. NEVER commit the filled file.
# Lines starting with # are ignored; empty values mean "not provided".

# --- Claude Code authentication (one of these) --------------------------------
# Long-lived token (one year): run `claude setup-token` on any machine with a browser, paste here.
CLAUDE_CODE_OAUTH_TOKEN=
# ...or a Console API key instead:
ANTHROPIC_API_KEY=

# --- GitHub (to push branches, open and merge PRs) ------------------------------
# Fine-grained token for raute1-org/LANoMAT only: Contents RW, Pull requests RW, Actions R.
GH_TOKEN=
GIT_NAME="LANoMAT VM session"
GIT_EMAIL=

# --- Notifications to your phone (optional, pick one or both) -------------------
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=

# --- Tailscale -------------------------------------------------------------------
# Reusable, non-ephemeral auth key (tag it, e.g. tag:lanomat). Used by bootstrap.sh.
TS_AUTHKEY=
TS_HOSTNAME=lanomat-control

# --- The three servers (Tailscale names/IPs) -------------------------------------
PUBLIC_HOST=
PUBLIC_SSH_USER=root
GAMES_HOST=
GAMES_SSH_USER=root
CACHE_HOST=
CACHE_SSH_USER=root
# Private key for the servers (copy the file to ~/.ssh/ and name it here).
SSH_KEY_FILE=~/.ssh/lanomat_servers

# --- Domain / TLS ----------------------------------------------------------------
APP_DOMAIN=
ACME_EMAIL=
DNS_PROVIDER=
# Only for a wildcard certificate via DNS-01 (leave empty for HTTP-01):
DNS_API_TOKEN=

# --- Discord ---------------------------------------------------------------------
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
DISCORD_MATCH_CATEGORY_ID=
ADMIN_DISCORD_ID=

# --- Voice (both providers must work; choose passwords) ----------------------------
MUMBLE_SERVER_PASSWORD=
MUMBLE_ICE_SECRET=
TEAMSPEAK_QUERY_PASSWORD=
TEAMSPEAK_ADMIN_TOKEN=

# --- Optional integrations ---------------------------------------------------------
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
MUSIC_ASSISTANT_URL=
MUSIC_ASSISTANT_TOKEN=
MUSIC_ASSISTANT_PLAYER_ID=
# Pelican tokens are created during the panel setup by the session; leave empty.
