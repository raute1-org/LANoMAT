{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lanomat.local/schema/lanomat.recipe/v1.json",
    "title": "LANoMAT game recipe v1",
    "description": "A LANoMAT game recipe: one game, its LAN files, and the ordered steps an assistant or installer follows to put it on a PC.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "slug",
        "title",
        "aliases",
        "version",
        "status",
        "platforms",
        "summary",
        "description",
        "license",
        "skill",
        "requires",
        "steps",
        "metadata"
    ],
    "properties": {
        "schema": {
            "const": "lanomat.recipe/v1"
        },
        "slug": {
            "$ref": "#/$defs/slug"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "aliases": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
            },
            "uniqueItems": true,
            "default": []
        },
        "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
        },
        "status": {
            "enum": ["draft", "published", "archived"]
        },
        "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "enum": ["windows", "linux", "macos"]
            }
        },
        "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "homepage": {
            "type": "string",
            "format": "uri"
        },
        "license": {
            "type": "string",
            "minLength": 1
        },
        "cover": {
            "type": "string"
        },
        "play_url": {
            "type": "string",
            "pattern": "^$|^https?://",
            "description": "Page a player opens to play on the LAN. Use the {{host}} template variable for the LAN address of the machine that hosts the game; localhost is only correct on that machine itself."
        },
        "launch_targets": {
            "type": "array",
            "description": "Ways to start the installed game, when they differ (for example flat versus VR). The first entry is the default.",
            "items": {
                "$ref": "#/$defs/launchTarget"
            }
        },
        "skill": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
                "name": {
                    "$ref": "#/$defs/slug"
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                },
                "compatibility": {
                    "type": "string",
                    "maxLength": 200
                }
            }
        },
        "requires": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/requirement"
            }
        },
        "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "$ref": "#/$defs/step"
            }
        },
        "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["genre", "players", "lan_recommended", "tags"],
            "properties": {
                "genre": {
                    "type": "string",
                    "minLength": 1
                },
                "players": {
                    "type": "string",
                    "minLength": 1
                },
                "lan_recommended": {
                    "type": "boolean"
                },
                "live_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "A live deployment of this recipe, when one exists (for example a LAN event's public UT2004VR server)."
                },
                "server": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "address", "port", "connect_url"],
                    "description": "The one public server of a browser recipe. It is not a managed ServerLink row: the recipe page shows it and 'join' opens connect_url.",
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1
                        },
                        "address": {
                            "type": "string",
                            "minLength": 1
                        },
                        "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        },
                        "connect_url": {
                            "type": "string",
                            "pattern": "^https?://"
                        },
                        "players": {
                            "type": "string",
                            "minLength": 1,
                            "description": "One short line for the game card, e.g. 'Ein Server · Nickname · Join/Leave'."
                        }
                    }
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "players_max": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024,
                    "description": "Highest simultaneous player count the recipe's mode supports, for filtering and sorting. Use 1 for a single-player-only recipe."
                },
                "multiplayer": {
                    "type": "boolean",
                    "description": "False for a single-player-only recipe; the games page then leaves out servers and rounds. Omit for a game with a multiplayer mode."
                },
                "portable": {
                    "type": "boolean",
                    "description": "True when the required base archive is a ready-to-run game tree: unpacking it is the whole install. The LANoMAT launcher installs such a recipe on its own (it unpacks, checks the files a step verifies and starts a launch target, and never runs step commands)."
                },
                "store_ids": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Ids of this game in the stores the native client reads (Steam, Epic, GOG, Ubisoft). The client matches its installed games to a recipe by these ids, never by title. Omit when the game is in no store.",
                    "properties": {
                        "steam": {
                            "type": "string",
                            "pattern": "^[0-9]{1,10}$",
                            "description": "Steam app id, digits."
                        },
                        "epic": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9._-]{1,128}$",
                            "description": "Epic AppName from the game manifest."
                        },
                        "gog": {
                            "type": "string",
                            "pattern": "^[0-9]{1,20}$",
                            "description": "GOG game id, digits."
                        },
                        "ubisoft": {
                            "type": "string",
                            "pattern": "^[0-9]{1,10}$",
                            "description": "Ubisoft install id, digits."
                        }
                    }
                },
                "launcher_supported": {
                    "type": "boolean",
                    "description": "Orga override for the launcher: true offers the recipe in the launcher although it does not have the portable shape, false hides it there. Omit to let LANoMAT decide from the recipe."
                },
                "launch": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "target"],
                    "description": "How a launcher starts the game after the install. Omit when there is no single sensible entry point.",
                    "properties": {
                        "kind": {
                            "enum": ["steam", "uri", "exe"],
                            "description": "steam = Steam URL, uri = any other registered URL scheme, exe = executable inside the install target."
                        },
                        "target": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Steam/URI target or executable path. Template variables such as {{target}} are resolved by the installer."
                        },
                        "args": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "description": "Arguments passed to the executable, in order."
                        },
                        "notes": {
                            "type": "string",
                            "description": "What the user still has to do, for example choosing a server or a game from the emulator list."
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
        },
        "glob": {
            "type": "string",
            "minLength": 1
        },
        "launchTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "os", "command"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "maxLength": 64
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "os": {
                    "enum": ["windows", "linux", "macos", "any"]
                },
                "command": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Launch command. {{target}} is substituted by the launcher; {{server_host}}/{{server_port}} are already filled in (or empty) by the plan."
                },
                "shell": {
                    "enum": ["powershell", "cmd", "bash"]
                },
                "notes": {
                    "type": "string"
                }
            }
        },
        "requirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "label", "match", "required"],
            "properties": {
                "role": {
                    "enum": [
                        "base",
                        "iso",
                        "patch",
                        "mod",
                        "tool",
                        "avatar",
                        "content",
                        "config"
                    ]
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "os": {
                    "enum": ["windows", "linux", "macos", "any"],
                    "description": "Platform this file is for. Omit (or use any) for a file that fits every plan, such as the DVD image. A Windows-only zip and its Linux tarball are two requirements that differ only in os."
                },
                "match": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/glob"
                    },
                    "uniqueItems": true
                },
                "required": {
                    "type": "boolean"
                },
                "size_bytes": {
                    "type": "integer",
                    "minimum": 1
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^$|^[a-f0-9]{64}$"
                },
                "url": {
                    "type": "string",
                    "pattern": "^$|^https?://"
                },
                "manual": {
                    "type": "boolean",
                    "description": "True when the player supplies this file by hand: the installer asks for it and never matches it on the share. A required manual entry needs neither match patterns nor a url."
                },
                "notes": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                }
            }
        },
        "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shell", "run"],
            "properties": {
                "shell": {
                    "enum": ["powershell", "cmd", "bash"]
                },
                "run": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One shell command. {{target}}, {{downloads}}, {{os}}, {{server_host}} and {{server_port}} are substituted before it runs; {{server_host}}/{{server_port}} are filled in by LANoMAT when it builds the plan and are the empty string when no server of the game is visible."
                }
            }
        },
        "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "enum": ["file_exists", "dir_exists", "command"]
                },
                "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Path the check looks for. {{target}}, {{downloads}}, {{os}}, {{server_host}} and {{server_port}} are substituted before the check runs."
                },
                "command": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Command the check runs. Same template variables as a step command."
                },
                "os": {
                    "enum": ["windows", "linux", "macos", "any"],
                    "description": "Run this check only on the given platform; omit for any platform the step runs on."
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": ["file_exists", "dir_exists"]
                            }
                        },
                        "required": ["type"]
                    },
                    "then": {
                        "required": ["path"],
                        "properties": {
                            "path": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "command"
                            }
                        },
                        "required": ["type"]
                    },
                    "then": {
                        "required": ["command"],
                        "properties": {
                            "command": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            ]
        },
        "step": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "os", "optional", "detail"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "maxLength": 64
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "os": {
                    "enum": ["windows", "linux", "macos", "any"]
                },
                "optional": {
                    "type": "boolean"
                },
                "detail": {
                    "type": "string",
                    "minLength": 1
                },
                "commands": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/command"
                    }
                },
                "verify": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/verification"
                    }
                }
            }
        }
    }
}
