{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lanomat.local/schema/lanomat.recipe/v1.json",
    "title": "LANoMAT game recipe v1",
    "description": "A LANoMAT game recipe: one game, its LAN files, and the ordered steps an assistant or installer follows to put it on a PC.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "slug",
        "title",
        "aliases",
        "version",
        "status",
        "platforms",
        "summary",
        "description",
        "license",
        "skill",
        "requires",
        "steps",
        "metadata"
    ],
    "properties": {
        "schema": {
            "const": "lanomat.recipe/v1"
        },
        "slug": {
            "$ref": "#/$defs/slug"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "aliases": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
            },
            "uniqueItems": true,
            "default": []
        },
        "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
        },
        "status": {
            "enum": ["draft", "published", "archived"]
        },
        "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "enum": ["windows", "linux", "macos"]
            }
        },
        "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "homepage": {
            "type": "string",
            "format": "uri"
        },
        "license": {
            "type": "string",
            "minLength": 1
        },
        "cover": {
            "type": "string"
        },
        "skill": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
                "name": {
                    "$ref": "#/$defs/slug"
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                },
                "compatibility": {
                    "type": "string",
                    "maxLength": 200
                }
            }
        },
        "requires": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/requirement"
            }
        },
        "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "$ref": "#/$defs/step"
            }
        },
        "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["genre", "players", "lan_recommended", "tags"],
            "properties": {
                "genre": {
                    "type": "string",
                    "minLength": 1
                },
                "players": {
                    "type": "string",
                    "minLength": 1
                },
                "lan_recommended": {
                    "type": "boolean"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "launch": {
                    "description": "How to start the installed game. A string is a flat command or executable path (\"/games/ut2004/System/ut2004-bin-amd64\"). An object separates the kind from the target: {kind: steam, target: \"<appid>\"}, {kind: uri, target: \"steam://rungameid/…\"}, {kind: exe, target: \"C:\\\\Games\\\\…\\\\UT2004.exe\", args: [\"-nosplash\"]}. For several ways to start the same install (flat versus VR) use metadata.launch_targets instead.",
                    "oneOf": [
                        {
                            "type": "string",
                            "minLength": 1
                        },
                        {
                            "$ref": "#/$defs/launchSpec"
                        }
                    ]
                },
                "launch_targets": {
                    "description": "Named ways to start the installed game, most useful first (for example flat and VR). Supersedes metadata.launch when present; {{target}} and {{avatars}} are substituted per install.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/launchTarget"
                    }
                },
                "launch_vr": {
                    "description": "Legacy shortcut for a second (VR) start command. Equivalent to a launch_targets entry with id \"vr\".",
                    "type": "string",
                    "minLength": 1
                },
                "play_url": {
                    "description": "Browser game or web front end to open. Use the {{host}} template for the LAN address of the machine that serves it; the app substitutes the request host, so never hardcode localhost.",
                    "type": "string",
                    "minLength": 1
                },
                "multiplayer": {
                    "type": "boolean"
                },
                "players_max": {
                    "type": "integer",
                    "minimum": 1
                },
                "install_size": {
                    "type": "string",
                    "minLength": 1
                },
                "note": {
                    "type": "string"
                }
            }
        }
    },
    "$defs": {
        "launchSpec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target"],
            "properties": {
                "kind": {
                    "enum": ["steam", "uri", "exe"],
                    "description": "steam: target is the Steam app id; uri: target is a full URI (steam://, xbox://, …); exe: target is an executable path."
                },
                "target": {
                    "type": "string",
                    "minLength": 1
                },
                "args": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ],
                    "description": "Arguments appended to the exe/steam target; ignored for uri."
                },
                "shell": {
                    "enum": ["powershell", "cmd", "bash"]
                },
                "notes": {
                    "type": "string"
                }
            }
        },
        "launchTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "os", "command"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "maxLength": 64,
                    "description": "Stable identifier the client asks for (flat, vr, …)."
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "os": {
                    "enum": ["windows", "linux", "macos", "any"]
                },
                "command": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Command or executable path with {{target}} (install dir) and {{avatars}} (avatar dir) placeholders."
                },
                "shell": {
                    "enum": ["powershell", "cmd", "bash"]
                },
                "notes": {
                    "type": "string"
                }
            }
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
        },
        "glob": {
            "type": "string",
            "minLength": 1
        },
        "requirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "label", "match", "required"],
            "properties": {
                "role": {
                    "enum": [
                        "base",
                        "iso",
                        "patch",
                        "mod",
                        "tool",
                        "avatar",
                        "content",
                        "config"
                    ]
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "match": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/glob"
                    },
                    "uniqueItems": true
                },
                "required": {
                    "type": "boolean"
                },
                "size_bytes": {
                    "type": "integer",
                    "minimum": 1
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^$|^[a-f0-9]{64}$"
                },
                "url": {
                    "type": "string",
                    "pattern": "^$|^https?://"
                },
                "notes": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "manual": {
                    "type": "boolean"
                }
            }
        },
        "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shell", "run"],
            "properties": {
                "shell": {
                    "enum": ["powershell", "cmd", "bash"]
                },
                "run": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
                "type": {
                    "enum": ["file_exists", "dir_exists", "command"]
                },
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": ["file_exists", "dir_exists"]
                            }
                        },
                        "required": ["type"]
                    },
                    "then": {
                        "required": ["path"],
                        "properties": {
                            "path": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "command"
                            }
                        },
                        "required": ["type"]
                    },
                    "then": {
                        "required": ["command"],
                        "properties": {
                            "command": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            ]
        },
        "step": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "os", "optional", "detail"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "maxLength": 64
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "os": {
                    "enum": ["windows", "linux", "any"]
                },
                "optional": {
                    "type": "boolean"
                },
                "detail": {
                    "type": "string",
                    "minLength": 1
                },
                "commands": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/command"
                    }
                },
                "verify": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/verification"
                    }
                }
            }
        }
    }
}
