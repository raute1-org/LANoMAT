{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LANoMAT Launcher",
  "version": "0.1.0",
  "identifier": "app.lanomat.launcher",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LANoMAT Launcher",
        "width": 960,
        "height": 720,
        "minWidth": 520,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "LANoMAT",
    "shortDescription": "LANoMAT Launcher",
    "longDescription": "LANoMAT one-click game launcher for the LAN party.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lanomat"]
      }
    }
  }
}
