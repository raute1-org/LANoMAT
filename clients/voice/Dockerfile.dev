# Reproducible build and test environment for the native voice client.
# Stages (base image pinned to rust:1.91-bookworm):
#   core  CLI and library:  docker build --target core -t lanomat-voice-dev -f Dockerfile.dev .
#   app   + Tauri desktop shell and the headless smoke tools:
#                           docker build --target app -t lanomat-voice-app-dev -f Dockerfile.dev .
#
# The prebuilt libwebrtc that the LiveKit SDK links needs clang 21 or newer (its hermetic
# libc++ check fails with Debian bookworm's clang 14), so clang comes from apt.llvm.org.
FROM rust:1.91-bookworm AS core

ARG LLVM_VERSION=21

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
        libasound2-dev pkg-config libssl-dev cmake \
        libx11-dev libxext-dev libgl1-mesa-dev libdrm-dev libgbm-dev libva-dev \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] https://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-${LLVM_VERSION} main" \
        > /etc/apt/sources.list.d/llvm.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        clang-${LLVM_VERSION} libclang-${LLVM_VERSION}-dev lld-${LLVM_VERSION} \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang-${LLVM_VERSION} \
    CXX=clang++-${LLVM_VERSION} \
    LIBCLANG_PATH=/usr/lib/llvm-${LLVM_VERSION}/lib

RUN rustup component add clippy rustfmt

WORKDIR /work

# ---- app: Tauri v2 on Linux (WebKitGTK 4.1, libsoup 3, tray via libayatana-appindicator) plus what
# the headless smoke needs: Xvfb, a private D-Bus, xdotool to click, ImageMagick for screenshots.
FROM core AS app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libwebkit2gtk-4.1-dev libsoup-3.0-dev libgtk-3-dev librsvg2-dev \
        libayatana-appindicator3-dev libxdo-dev \
        xvfb xauth dbus dbus-x11 xdotool imagemagick x11-utils \
        python3 procps \
    && rm -rf /var/lib/apt/lists/*

# ---- windows: cross-build for x86_64-pc-windows-msvc from Linux with cargo-xwin (downloads the
# Windows SDK/CRT once into XWIN_CACHE_DIR; clang-cl and lld-link do the compile and link). NASM
# is needed by aws-lc-sys on Windows targets, zip packs the portable app archive.
FROM app AS windows

RUN apt-get update \
    && apt-get install -y --no-install-recommends nasm zip nsis \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-pc-windows-msvc \
    && cargo install cargo-xwin --version 0.23.1 --locked

ENV XWIN_CACHE_DIR=/xwin-cache \
    XWIN_ACCEPT_LICENSE=1
