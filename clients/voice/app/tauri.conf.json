{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LANoMAT Voice",
  "version": "0.1.0",
  "identifier": "app.lanomat.voice",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LANoMAT Voice",
        "width": 960,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "LANoMAT",
    "shortDescription": "LANoMAT Voice",
    "longDescription": "LANoMAT voice and LAN party companion (desktop app).",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
