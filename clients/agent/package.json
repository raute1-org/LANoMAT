        "commander": "^15.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    }
}
