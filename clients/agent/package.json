{
    "name": "@lanomat/agent",
    "version": "0.1.0",
    "description": "LANoMAT desktop installer agent: turn a LANoMAT MCP server into a pi coding agent that installs LAN games by chatting.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "lanomat-agent": "dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22.12.0 <25",
        "npm": ">=10"
    },
    "keywords": [
        "lanomat",
        "lan-party",
        "installer",
        "mcp",
        "pi",
        "cli"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/raute1-org/LANoMAT.git",
        "directory": "clients/agent"
    },
    "homepage": "https://github.com/raute1-org/LANoMAT/tree/main/clients/agent#readme",
    "bugs": {
        "url": "https://github.com/raute1-org/LANoMAT/issues"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run lint && npm test && npm run build",
        "audit:prod": "npm audit --omit=dev",
        "prepack": "npm run build",
        "prepublishOnly": "npm run lint && npm test"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "^1.6.0",
        "@modelcontextprotocol/sdk": "^1.32.0",
        "commander": "^15.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    }
}
