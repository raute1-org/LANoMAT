{
    "name": "@lanomat/agent",
    "version": "0.1.0",
    "description": "LANoMAT desktop installer agent: turn a LANoMAT MCP server into a pi coding agent that installs LAN games by chatting.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "lanomat-agent": "dist/cli.js"
    },
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
